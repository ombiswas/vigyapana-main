PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vigyapana_db

# JWT Secrets
JWT_ACCESS_SECRET=vigyapana_super_secret_access_key_2026_change_in_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=vigyapana_super_secret_refresh_key_2026_change_in_prod
JWT_REFRESH_EXPIRY=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer / SMTP Engine
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Vigyapana Services <noreply@vigyapana.com>"
ADMIN_NOTIFICATION_EMAIL=admin@vigyapana.com
